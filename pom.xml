<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- Padre del proyecto: hereda de Spring Boot la gestión de versiones y el plugin de empaquetado -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.9</version>
		<relativePath/>
	</parent>

	<groupId>com.sonidovivo</groupId>
	<artifactId>sonido-vivo-servicios</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>sonido-vivo-servicios</name>
	<description>Microservicios de Sonido Vivo: cuatro de negocio y tres de soporte</description>

	<properties>
		<java.version>21</java.version>
		<spring-cloud.version>2025.1.4</spring-cloud.version>
	</properties>

	<modules>
		<module>config</module>
		<module>eureka</module>
		<module>catalogo</module>
		<module>usuarios</module>
		<module>boletas</module>
		<module>despachos</module>
		<module>mensajeria</module>
		<module>gateway</module>
	</modules>

	<dependencies>
		<!-- Presentes en todos: salud del servicio y menos código repetido. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<!-- Cada módulo produce su propio jar ejecutable -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
